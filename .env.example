# =============================================================================
#  Revenium Agent Fleet Demo - configuration
#
#  1. Copy this file:   cp .env.example .env
#  2. Fill in the FOUR keys in the box below. Nothing else needs to change.
#  3. Check your setup: python run_fleet.py --check
# =============================================================================


# #############################################################################
# ###                                                                       ###
# ###   >>>  REQUIRED - FILL IN ALL FOUR KEYS BEFORE YOUR FIRST RUN  <<<    ###
# ###                                                                       ###
# #############################################################################

# [1/4] Anthropic API key. Get it at: console.anthropic.com -> API Keys
#       Looks like: sk-ant-...
ANTHROPIC_API_KEY=

# [2/4] OpenAI API key. Get it at: platform.openai.com -> API keys
#       Looks like: sk-...
OPENAI_API_KEY=

# [3/4] Revenium METERING key. Records every LLM call and its cost.
#       Get it in the Revenium app -> API Keys.
#       Must start with hak_ or rev_ . The run stops with an error if it is missing.
REVENIUM_METERING_API_KEY=

# [4/4] Revenium WRITE key. Reports each ticket's business outcome
#       (DEFLECTED / ESCALATED / FAILED) on its Revenium job.
#       Get it in the Revenium app -> API Keys (a write-scope key).
#       Must start with rev_sk_ . This is a DIFFERENT key from the metering key above:
#       pasting the metering key here causes 403 errors.
#       If you leave it empty, the fleet still runs but prints "Outcomes skipped"
#       and Revenium shows no outcomes.
REVENIUM_WRITE_API_KEY=

# #############################################################################
# ###                   END OF REQUIRED SETTINGS                            ###
# #############################################################################


# -----------------------------------------------------------------------------
# Everything below already has a working default. Leave it alone unless you
# have a specific reason to change it.
#
# Why every line is listed: run_fleet.py loads .env with override=True, so a
# variable listed here always beats a value exported in your shell (for example
# a REVENIUM_METERING_API_KEY for a different tenant). A variable missing from
# .env lets the shell value leak through. Keep every line, even unchanged ones.
# -----------------------------------------------------------------------------

# --- Revenium connection ---
# Your tenant's API address. Must start with https:// (the preflight warns otherwise).
REVENIUM_METERING_BASE_URL=https://api.revenium.ai
# Leave empty: outcomes then go to the same address as metering.
REVENIUM_PROFITSTREAM_BASE_URL=
# Label attached to every call in Revenium
REVENIUM_ENVIRONMENT=demo
# Optional. Outcomes find your team from the write key when this is empty.
REVENIUM_TEAM_ID=

# --- Output and privacy ---
# SDK log level. CRITICAL is the quietest; the demo prints its own error lines.
REVENIUM_LOG_LEVEL=WARNING
# Keep false: prompt and response text is never sent to Revenium
REVENIUM_CAPTURE_PROMPTS=false
# Seconds to wait for queued metering records at exit
REVENIUM_SHUTDOWN_TIMEOUT_SECONDS=15

# --- Keep these empty ---
# The demo builds its own call trees and jobs. A value exported in your shell
# would attach calls to a foreign trace or tag them with the wrong ticket.
REVENIUM_PARENT_TRANSACTION_ID=
REVENIUM_TICKET_ID=
REVENIUM_AGENTIC_JOB_VERSION=

# --- Client-side circuit breaker (advanced; keep disabled) ---
# Only useful with a Revenium Cost Control rule and REVENIUM_TEAM_ID set.
REVENIUM_CIRCUIT_BREAKER_ENABLED=false
REVENIUM_CB_POLL_INTERVAL_SECONDS=10
REVENIUM_CB_FAIL_MODE=open

# --- Model per agent ---
# Change one only if your account cannot use it or Revenium shows $0 cost for it.
# Fallbacks: claude-haiku-4-5, claude-sonnet-4-6, gpt-5-mini, gpt-4o-mini.
# Models starting with claude-haiku-4, claude-3, gpt-4o or gpt-4.1 are called
# without effort parameters. An empty value uses the default shown.
MODEL_CLASSIFIER=claude-haiku-5-5
MODEL_RESEARCHER=gpt-6-luna
MODEL_RESPONDER=claude-sonnet-5-5
MODEL_QA=gpt-6-luna
